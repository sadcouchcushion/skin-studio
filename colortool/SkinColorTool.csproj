<Project Sdk="Microsoft.NET.Sdk">

  <!-- Small console helper Skin Studio shells out to (like python/rrcli/retoc).
       Uses the UAssetAPI + Marvel.usmap already on disk with rrcli's KawaiiPhysics
       binding - the same net8 parser that is proven to round-trip Rivals assets.
       Framework-dependent: the net8 runtime is already installed. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SkinColorTool</AssemblyName>
    <RootNamespace>SkinColorTool</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- file details shown in Explorer's Properties and read by scanners -->
    <Product>Skin Studio for Marvel Rivals</Product>
    <AssemblyTitle>Skin Studio colour tool</AssemblyTitle>
    <Description>Reads and writes material colours in Marvel Rivals assets for Skin Studio.</Description>
    <Company>Chicory Design Studio</Company>
    <Authors>Alli / Chicory Design Studio</Authors>
    <Copyright>Alli / Chicory Design Studio</Copyright>
    <Version>1.0.3</Version>
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\branding\skin-studio.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <!-- folder holding UAssetAPI.dll, Newtonsoft.Json.dll and ZstdSharp.dll
         (see BUILDING.md); override with -p:LibDir=... -->
    <LibDir Condition="'$(LibDir)' == ''">$(MSBuildThisFileDirectory)lib\</LibDir>
  </PropertyGroup>

  <!-- Reference the DLLs in place; copy them (and known runtime deps) next to our
       exe so they resolve without a package restore. An AssemblyResolve fallback
       in Program.cs covers any remaining transitive deps from the same folder. -->
  <ItemGroup>
    <Reference Include="UAssetAPI">
      <HintPath>$(LibDir)UAssetAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(LibDir)Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ZstdSharp">
      <HintPath>$(LibDir)ZstdSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>

